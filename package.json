{
  "name": "multiservicios-sanabria-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "description": "Aplicación web corporativa de Multiservicios Sanabria",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest",
    "verify:content": "tsx scripts/verifyContentFixture.ts",
    "build:client": "npm run verify:content && npm exec -- vite build --outDir dist/client",
    "build:server": "tsx scripts/buildServer.ts dist/server",
    "build": "npm run prisma:generate && tsx scripts/build.ts",
    "start": "npm run prisma:migrate:deploy && node dist/server/index.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "express": "4.22.3",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/express": "4.17.21",
    "@types/node": "22.12.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.20",
    "axe-core": "4.10.2",
    "concurrently": "9.1.0",
    "fast-check": "3.23.2",
    "jsdom": "25.0.1",
    "postcss": "8.5.33",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "tailwindcss": "3.4.15",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
