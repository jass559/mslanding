{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@client": ["client/src"],
      "@client/*": ["client/src/*"],
      "@shared": ["shared/index.ts"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["client/src/**/*.ts", "client/src/**/*.tsx", "shared/**/*.ts", "shared/**/*.tsx"],
  "exclude": ["server", "dist", "node_modules"]
}
